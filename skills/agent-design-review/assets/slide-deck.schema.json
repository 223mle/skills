{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Starter semantic slide-deck request",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/titleBullets"},
          {"$ref": "#/$defs/comparison"},
          {"$ref": "#/$defs/textChart"}
        ]
      }
    }
  },
  "$defs": {
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "bullet": {"type": "string", "minLength": 1, "maxLength": 160},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "shortBullets": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"$ref": "#/$defs/bullet"}
    },
    "titleBullets": {
      "type": "object", "additionalProperties": false,
      "required": ["layout", "title", "bullets"],
      "properties": {
        "layout": {"const": "title-bullets"},
        "title": {"$ref": "#/$defs/title"},
        "bullets": {
          "type": "array", "minItems": 3, "maxItems": 5,
          "items": {"$ref": "#/$defs/bullet"}
        }
      }
    },
    "comparisonSide": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "bullets"],
      "properties": {
        "heading": {"$ref": "#/$defs/title"},
        "bullets": {"$ref": "#/$defs/shortBullets"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["layout", "title", "left", "right"],
      "properties": {
        "layout": {"const": "comparison"},
        "title": {"$ref": "#/$defs/title"},
        "left": {"$ref": "#/$defs/comparisonSide"},
        "right": {"$ref": "#/$defs/comparisonSide"}
      }
    },
    "textChart": {
      "type": "object", "additionalProperties": false,
      "required": ["layout", "title", "bullets", "chart"],
      "properties": {
        "layout": {"const": "text-chart"},
        "title": {"$ref": "#/$defs/title"},
        "bullets": {"$ref": "#/$defs/shortBullets"},
        "chart": {
          "type": "object", "additionalProperties": false,
          "required": ["datasetId", "categoryColumnId", "valueColumnId"],
          "properties": {
            "datasetId": {"$ref": "#/$defs/identifier"},
            "categoryColumnId": {"$ref": "#/$defs/identifier"},
            "valueColumnId": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    }
  }
}
